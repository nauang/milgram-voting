# Copie para .env.local e preencha. NUNCA commitar o .env.local.

# --- Banco (Prisma) ---
# Dev: SQLite local. Prod: URL do Postgres (Neon/Supabase).
DATABASE_URL="file:./dev.db"

# --- Auth do /admin (NextAuth / Auth.js) ---
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Credenciais do admin (PROPOSTA: confirmar o modelo de login na Etapa 3)
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# --- Anti-fraude do voto ---
# Sal do sha256 do voterKey. Trocar o valor invalida o histórico de 24h.
# Gerar com: openssl rand -hex 32
VOTER_SALT=""

# --- Rate-limit (Upstash Redis) ---
# Em dev, sem estas variáveis, usaremos fallback em memória (ver fluxo-voto.md, F3)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Observabilidade (opcional, só em produção) ---
SENTRY_DSN=""
