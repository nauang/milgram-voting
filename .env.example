# ============================================================
# MILGRAM Voting — Exemplo de variáveis de ambiente
# ============================================================
# Copie para .env.local e preencha os valores no seu computador.
# Na Vercel, configure as variáveis no painel do projeto.
# NUNCA versione .env.local, senhas, tokens ou certificados privados.

# --- Banco de dados (Prisma 7 + PostgreSQL / Supabase) ---
# DATABASE_URL: conexão utilizada pela aplicação (pooler, se aplicável).
# DIRECT_URL: conexão usada pelo Prisma para aplicar migrações.
# Para bancos remotos, use TLS com certificado validado.
# O cliente aceita sslmode=verify-full na URL.
DATABASE_URL=""
DIRECT_URL=""

# Opcional: CA PEM personalizada para a conexão da aplicação.
# Pode conter quebras de linha reais ou a sequência literal \n.
# Alternativa ao parâmetro sslrootcert da DATABASE_URL; não use ambos.
# DATABASE_SSL_CA_PEM=""

# --- Autenticação administrativa (Auth.js / NextAuth v5) ---
# Gerar com: openssl rand -base64 32
AUTH_SECRET=""

# Normalmente o Auth.js detecta a URL de produção na Vercel.
# Para ambientes com proxy/configuração especial, defina se necessário.
# AUTH_URL="http://localhost:3000"

ADMIN_EMAIL=""
# Hash scrypt gerado por scripts/hash-password.ts; nunca a senha em texto puro.
ADMIN_PASSWORD_HASH=""

# --- Identificação antifraude ---
# Gerar com: openssl rand -hex 32
# Não altere após receber votos sem avaliar o impacto nos identificadores.
VOTER_SALT=""

# --- Rate limiting distribuído (Upstash Redis) ---
# Ambas as variáveis são obrigatórias em produção.
# Sem elas, apenas desenvolvimento/testes podem usar memória local.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Supabase Storage (gerenciamento de imagens no servidor) ---
SUPABASE_URL=""
# Chave secreta: nunca use NEXT_PUBLIC_ nem envie ao navegador.
SUPABASE_SECRET_KEY=""
# Bucket esperado pelo código: characters.

# --- SEO e metadados (opcional) ---
# Defina com a URL pública completa, sem barra final.
# Se não definir, o projeto usa a URL padrão em src/lib/site.ts.
# NEXT_PUBLIC_SITE_URL="https://seu-dominio.example"

# --- Testes locais com banco PostgreSQL descartável ---
# Configure as variáveis abaixo SOMENTE no terminal de testes ou CI.
# NUNCA aponte TEST_DATABASE_URL para o banco de produção.
# TEST_DATABASE_URL="postgresql://usuario:senha@127.0.0.1:55432/milgram_e2e"
# TEST_DIRECT_URL="postgresql://usuario:senha@127.0.0.1:55432/milgram_e2e"
# CONFIRM_TEST_DB_WIPE="yes" # Somente após verificar o destino!
# E2E_ADMIN_EMAIL, E2E_ADMIN_PASSWORD e E2E_ADMIN_PASSWORD_HASH
# devem ser exclusivos dos testes, nunca credenciais reais.
